{
  "name": "athena-query-client",
  "version": "1.1.0",
  "description": "The Athena Query Client is a simple package that provides a method to retrieve data from Amazon Athena by merely passing an SQL query as the single parameter of the method.",
  "main": "./dist/cjs/athena-query-client.js",
  "module": "./dist/esm/athena-query-client.js",
  "types": "./dist/cjs/athena-query-client.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/athena-query-client.d.ts",
        "default": "./dist/esm/athena-query-client.js"
      },
      "require": {
        "types": "./dist/cjs/athena-query-client.d.ts",
        "default": "./dist/cjs/athena-query-client.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/*/package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeremenkov/athena-query-client.git"
  },
  "author": "Vitaliy Yeremenko",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/postbuild.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@aws-sdk/client-athena": "^3.429.0"
  },
  "devDependencies": {
    "@aws-sdk/client-athena": "^3.1152.0",
    "@types/jest": "^29",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "aws-sdk-client-mock": "^4",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29",
    "prettier": "^3.0.0",
    "ts-jest": "^29",
    "typescript": "^5.1.3"
  }
}
